  /* ── Quick-add lead modal ─────────────────────────────────────── */
  const MODAL_HTML = `
<div class="modal fade" id="addLeadModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-3">
        <h5 class="modal-title">Quick Add Lead</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="quickAddLeadForm" class="row g-3">
          <div class="col-12">
            <label class="form-label">Contact Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="ql-name" placeholder="Full name" required>
          </div>
          <div class="col-12">
            <label class="form-label">Phone (+92) <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">+92</span>
              <input type="tel" class="form-control" id="ql-phone" placeholder="300 1234567" required>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label">Source</label>
            <select class="form-select" id="ql-source">
              <option value="web">Website</option>
              <option value="whatsapp" selected>WhatsApp</option>
              <option value="referral">Referral</option>
              <option value="cold_call">Cold Call</option>
              <option value="event">Event</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Owner</label>
            <select class="form-select" id="ql-owner">
              ${(window.CRM_DUMMY ? window.CRM_DUMMY.users.data : []).map(u => `<option value="${u.user_id}">${u.display_name}</option>`).join('')}
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Est. Value (PKR)</label>
            <input type="number" class="form-control" id="ql-value" placeholder="0">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light waves-effect waves-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary waves-effect waves-light" id="quickAddLeadBtn">Add Lead</button>
      </div>
    </div>
  </div>
</div>
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
  <div id="crm-error-toast" class="toast align-items-center text-bg-danger border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body">An error occurred.</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>`;

  /* ── Inject into DOM ─────────────────────────────────────────── */
  const layout = document.querySelector('.page-layout');
  if (layout) {
    const main = layout.querySelector('main.app-wrapper');
    if (main) {
      main.insertAdjacentHTML('beforebegin', HEADER_HTML + SIDEBAR_HTML + MODAL_HTML);
    }
  }

  /* ── Post-injection: wire logout, update live counts ─────────── */
  document.addEventListener('DOMContentLoaded', function () {
    if (window.CRM_DUMMY) {
      const cnt = window.CRM_DUMMY.overdueFollowups.length;
      const badge = document.getElementById('sidebar-overdue-count');
      if (badge) { badge.textContent = cnt; badge.style.display = cnt ? '' : 'none'; }
      const badgeD = document.getElementById('sidebar-overdue-count-d');
      if (badgeD) { badgeD.textContent = cnt; badgeD.style.display = cnt ? '' : 'none'; }
      const todayBadge = document.getElementById('header-today-leads');
      if (todayBadge) todayBadge.textContent = window.CRM_DUMMY.todayLeads.length;
    }

    const qaBtn = document.getElementById('quickAddLeadBtn');
    if (qaBtn) {
      qaBtn.addEventListener('click', async function () {
        const name   = document.getElementById('ql-name').value.trim();
        const phone  = '+92' + document.getElementById('ql-phone').value.replace(/\D/g,'');
        const source = document.getElementById('ql-source').value;
        const owner  = document.getElementById('ql-owner').value;
        const value  = parseInt(document.getElementById('ql-value').value) || 0;
        if (!name || phone.length < 10) return;
        qaBtn.disabled = true;
        try {
          await window.CRM_API.leads.patch('new', { contact_name: name, contact_phone_e164: phone, source, owner_id: owner, estimated_value: value });
          bootstrap.Modal.getInstance(document.getElementById('addLeadModal')).hide();
          if (typeof window.CRM_PAGE_REFRESH === 'function') window.CRM_PAGE_REFRESH();
        } catch(e) {
          window.CRM.components.showError('Failed to add lead. Please try again.');
        } finally { qaBtn.disabled = false; }
      });
    }
  });
})();
