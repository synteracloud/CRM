{
  "name": "nexlink-crm-frontend",
  "version": "1.3.0",
  "description": "NexLink CRM Admin Dashboard — Bootstrap 5 frontend for Pakistan CRM OS",
  "main": "src/index.html",
  "scripts": {
    "sass:watch": "sass --watch src/assets/scss/main.scss src/assets/css/styles.css --silence-deprecation=import,global-builtin,if-function,color-functions",
    "sass:build": "sass src/assets/scss/main.scss src/assets/css/styles.css --style=compressed --no-source-map --silence-deprecation=import,global-builtin,if-function,color-functions",
    "rtl:build": "rtlcss src/assets/css/styles.css src/assets/css/styles-rtl.css",
    "build": "npm run sass:build && npm run rtl:build",
    "serve": "http-server src -p 3001 --cors -c-1",
    "dev": "http-server src -p 3001 --cors -c-1"
  },
  "author": "layoutdrop",
  "license": "ISC",
  "dependencies": {
    "rtlcss": "^4.3.0",
    "sass": "^1.90.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "playwright": "^1.59.1"
  }
}
