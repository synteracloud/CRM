# .env.example — P-023
# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to version control.
#
# Constraint C-009: JAZZCASH_STUB_MODE and EASYPAISA_STUB_MODE must remain
# 'true' until sandbox credentials have been verified (P-016).

# ── Core ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=crm
DB_PASSWORD=changeme
DB_NAME=crm
DB_POOL_MAX=10

# ── Gateway ─────────────────────────────────────────────────────────────────────
PORT=3000
SERVICE_NAME=crm-gateway
SERVICE_VERSION=dev
REGION=local

# ── JWT Authentication (P-021) ───────────────────────────────────────────────────
# Local dev: use HS256 with a shared secret.
# Production: use RS256 — set JWT_PUBLIC_KEY to the PEM-encoded public key.
#             JWT_SECRET should be unset in production.
JWT_SECRET=dev-secret-change-in-production
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_ISSUER=crm-local
JWT_AUDIENCE=crm-api
# Set to 'true' ONLY in integration tests — never in production
SKIP_JWT_VERIFICATION=false

# ── Python service URLs ──────────────────────────────────────────────────────────
# In docker-compose all point to the 'services' container.
# Override to split into separate microservices if needed.
FOLLOWUP_SERVICE_URL=http://localhost:5002
ACTIVITY_SERVICE_URL=http://localhost:5002
COLLECTIONS_SERVICE_URL=http://localhost:5002
CONVERSATION_SERVICE_URL=http://localhost:5002
SYNC_SERVICE_URL=http://localhost:5002

# ── Idempotency (P-004) ──────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_EVICT_INTERVAL=3600

# ── WhatsApp providers ───────────────────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
DIALOG360_WEBHOOK_SECRET=

# ── Payment gateways (C-009: always stub until P-016 sandbox tests pass) ─────────
JAZZCASH_STUB_MODE=true
JAZZCASH_API_URL=
JAZZCASH_PASSWORD=
JAZZCASH_HASH_KEY=
JAZZCASH_MERCHANT_ID=

EASYPAISA_STUB_MODE=true
EASYPAISA_API_URL=
EASYPAISA_STORE_PASSWORD=
EASYPAISA_ACCOUNT_NUM=
